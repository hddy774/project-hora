# Hora Economic Lab — 코드 서식 규칙
# 상세 설명: docs/standards/coding-conventions.md
# CI에서 `dotnet format --verify-no-changes` 로 강제한다.

root = true

# 모든 파일 공통
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# 구버전 Godot 구현은 기존 서식 유지 (탭 사용)
[games/**.{gd,tscn,cfg,godot}]
indent_style = tab

[*.cs]
max_line_length = 120

# --- using ---
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:error

# --- 중괄호·줄바꿈 (Allman) ---
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_prefer_braces = true:error
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# --- 공백 ---
csharp_space_around_binary_operators = before_and_after
csharp_space_after_comma = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_after_cast = false

# --- var 사용: 타입이 명확할 때만 ---
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:warning

# --- 코어는 C# 9: file-scoped namespace 금지 ---
csharp_style_namespace_declarations = block_scoped:error

# --- 기타 스타일 ---
dotnet_style_qualification_for_field = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_require_accessibility_modifiers = always:error
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_prefer_conditional_expression_over_return = false:none

# --- 이름 규칙 ---
# 인터페이스: I + PascalCase
dotnet_naming_rule.interfaces_rule.symbols = interface_symbols
dotnet_naming_rule.interfaces_rule.style = i_prefix_style
dotnet_naming_rule.interfaces_rule.severity = error
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefix_style.required_prefix = I
dotnet_naming_style.i_prefix_style.capitalization = pascal_case

# 타입·멤버: PascalCase
dotnet_naming_rule.types_rule.symbols = type_symbols
dotnet_naming_rule.types_rule.style = pascal_style
dotnet_naming_rule.types_rule.severity = error
dotnet_naming_symbols.type_symbols.applicable_kinds = class, struct, enum, delegate, method, property, event, namespace
dotnet_naming_style.pascal_style.capitalization = pascal_case

# 상수: PascalCase
dotnet_naming_rule.constants_rule.symbols = constant_symbols
dotnet_naming_rule.constants_rule.style = pascal_style
dotnet_naming_rule.constants_rule.severity = error
dotnet_naming_symbols.constant_symbols.applicable_kinds = field
dotnet_naming_symbols.constant_symbols.required_modifiers = const

# private static 필드: s_camelCase
dotnet_naming_rule.private_static_rule.symbols = private_static_symbols
dotnet_naming_rule.private_static_rule.style = s_prefix_style
dotnet_naming_rule.private_static_rule.severity = error
dotnet_naming_symbols.private_static_symbols.applicable_kinds = field
dotnet_naming_symbols.private_static_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_static_symbols.required_modifiers = static
dotnet_naming_style.s_prefix_style.required_prefix = s_
dotnet_naming_style.s_prefix_style.capitalization = camel_case

# private 필드: _camelCase
dotnet_naming_rule.private_fields_rule.symbols = private_field_symbols
dotnet_naming_rule.private_fields_rule.style = underscore_style
dotnet_naming_rule.private_fields_rule.severity = error
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscore_style.required_prefix = _
dotnet_naming_style.underscore_style.capitalization = camel_case

# 매개변수·지역 변수: camelCase
dotnet_naming_rule.locals_rule.symbols = local_symbols
dotnet_naming_rule.locals_rule.style = camel_style
dotnet_naming_rule.locals_rule.severity = error
dotnet_naming_symbols.local_symbols.applicable_kinds = parameter, local
dotnet_naming_style.camel_style.capitalization = camel_case

# --- 분석기 ---
# public 멤버 XML 주석 누락 = 오류 (프로젝트에서 GenerateDocumentationFile=true 필요)
dotnet_diagnostic.CS1591.severity = error
# 사용하지 않는 using·변수
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0059.severity = warning

# NUnit 테스트 이름은 명세의 대상_조건_기대결과 형식을 유지한다.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
