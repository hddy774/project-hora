{
  "schema_version": 2,
  "contract": "SEONRO_V021_PRODUCT_BOUNDARY_V1",
  "dependency_direction": "Desktop/Shell/Android -> Hosting -> Game -> Core (consumer -> dependency)",
  "boundary_document": "docs/architecture/v021-product-boundary.md",
  "line_policy": {
    "scope": "manual_csharp_and_xaml",
    "recommended_max": 1000,
    "hard_fail_on_line_count": false
  },
  "modules": [
    {
      "id": "Core",
      "project": "src/Chronicles.Core/Chronicles.Core.csproj",
      "roots": [
        "src/Chronicles.Core"
      ],
      "allowed_dependencies": [],
      "responsibility": "Engine-neutral product metadata and explicit-state deterministic RNG."
    },
    {
      "id": "Game",
      "project": "src/Chronicles.Game/Chronicles.Game.csproj",
      "roots": [
        "src/Chronicles.Game"
      ],
      "allowed_dependencies": [
        "Core"
      ],
      "responsibility": "Single 0.2.1 world authority, pure queries, commands and in-memory byte/hash/clone contract."
    },
    {
      "id": "Hosting",
      "project": "src/Chronicles.Hosting/Chronicles.Hosting.csproj",
      "roots": [
        "src/Chronicles.Hosting"
      ],
      "allowed_dependencies": [
        "Game"
      ],
      "responsibility": "Serialized session, file slot recovery/preservation and platform-neutral host adapters."
    },
    {
      "id": "Shell",
      "project": "src/Chronicles.Shell/Chronicles.Shell.csproj",
      "roots": [
        "src/Chronicles.Shell"
      ],
      "allowed_dependencies": [
        "Hosting"
      ],
      "responsibility": "Local browser host and shared Korean HTML; sends only session requests."
    },
    {
      "id": "Android",
      "project": "src/Chronicles.Android/Chronicles.Android.csproj",
      "roots": [
        "src/Chronicles.Android"
      ],
      "allowed_dependencies": [
        "Hosting"
      ],
      "responsibility": "Native Android WebView host; owns app-private path and lifecycle."
    },
    {
      "id": "Desktop",
      "project": "src/Chronicles.Desktop/Chronicles.Desktop.csproj",
      "roots": [
        "src/Chronicles.Desktop"
      ],
      "allowed_dependencies": [
        "Hosting"
      ],
      "responsibility": "WPF WebView2 host; EcologyWindow is the current entry."
    },
    {
      "id": "GameTests",
      "project": "tests/Chronicles.Game.Tests/Chronicles.Game.Tests.csproj",
      "roots": [
        "tests/Chronicles.Game.Tests"
      ],
      "allowed_dependencies": [
        "Game",
        "Hosting"
      ],
      "responsibility": "Functional product scenarios; measurement modes remain explicit final-stage tools."
    }
  ],
  "entrypoints": {
    "desktop": "src/Chronicles.Desktop/App.xaml.cs",
    "desktop_window": "src/Chronicles.Desktop/EcologyWindow.cs",
    "desktop_facade": "src/Chronicles.Hosting/EcologyApplicationSession.cs",
    "android": "src/Chronicles.Android/MainActivity.cs",
    "shell": "src/Chronicles.Shell/Program.cs",
    "session": "src/Chronicles.Hosting/GameSession.cs",
    "file_store": "src/Chronicles.Hosting/GameSaveStore.cs",
    "byte_codec": "src/Chronicles.Game/GameCodec.cs",
    "world": "src/Chronicles.Game/World.cs",
    "view": "src/Chronicles.Game/Queries.cs"
  },
  "legacy": {
    "root": "legacy/windows-pre-v021",
    "solution": "legacy/windows-pre-v021/Chronicles.slnx",
    "provenance": "legacy/windows-pre-v021/source-provenance.json",
    "current_product": false
  },
  "limits": {
    "static_check_is_runtime_proof": false,
    "unity_compatibility": "Not claimed; net10.0/latest C# and reflection-based System.Text.Json are current requirements.",
    "native_checks": "WPF WebView2 and actual Android APK install/launch/DOM checks are separate."
  }
}
