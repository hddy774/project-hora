; Experimental, offline monthly-economy prototype. Godot 4.6.
config_version=5

[application]
config/name="Hora Economic Lab · 호라경제연구실"
config/version="0.2.0"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/generated/app_icon.png"
boot_splash/image="res://assets/generated/app_icon.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.035, 0.063, 0.09, 1)

[display]
window/size/viewport_width=480
window/size/viewport_height=920
window/size/window_width_override=480
window/size/window_height_override=920
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 2D-only presentation uses a small budget for unused 3D lights.
limits/opengl/max_lights_per_object=2
limits/opengl/max_renderable_lights=4
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.063, 0.09, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true

[input_devices]
pointing/emulate_touch_from_mouse=true

[audio]
driver/enable_input=false
