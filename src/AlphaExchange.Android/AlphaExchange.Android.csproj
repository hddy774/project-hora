<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>AlphaExchange.App</RootNamespace>
    <ApplicationId>com.alphaexchange.offline</ApplicationId>
    <ApplicationVersion>10</ApplicationVersion>
    <ApplicationDisplayVersion>1.9.0</ApplicationDisplayVersion>
    <Version>$(ApplicationDisplayVersion)</Version>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <AndroidAsset Include="../../THIRD-PARTY-NOTICES.txt" Link="Assets/THIRD-PARTY-NOTICES.txt" />
    <AndroidAsset Include="../../licenses/*.txt" Link="Assets/licenses/%(Filename)%(Extension)" />
    <ProjectReference Include="../AlphaExchange.Core/AlphaExchange.Core.csproj" />
    <ProjectReference Include="../AlphaExchange.Client/AlphaExchange.Client.csproj" />
  </ItemGroup>
</Project>
