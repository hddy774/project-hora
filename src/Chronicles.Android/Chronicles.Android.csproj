<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.hora.xianxiaobserver</ApplicationId>
    <SeonroVersionMajor>$([System.Version]::Parse('$(Version)').Major)</SeonroVersionMajor>
    <SeonroVersionMinor>$([System.Version]::Parse('$(Version)').Minor)</SeonroVersionMinor>
    <SeonroVersionPatch>$([System.Version]::Parse('$(Version)').Build)</SeonroVersionPatch>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(SeonroVersionMajor), 1000000)), $([MSBuild]::Multiply($(SeonroVersionMinor), 1000)))), $(SeonroVersionPatch)))</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Chronicles.Hosting/Chronicles.Hosting.csproj" />
    <AndroidAsset Include="../Chronicles.Shell/index.compat.html" Link="index.html" />
  </ItemGroup>
</Project>
