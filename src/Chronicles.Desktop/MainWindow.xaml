                                        <DataGridTextColumn Header="구간" Binding="{Binding Scope}" Width="82" />
                                        <DataGridTextColumn Header="현재 기준" Binding="{Binding Cutoff}" Width="*" />
                                        <DataGridTextColumn Header="누적 자리 변경" Binding="{Binding Movement}" Width="112" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Expander x:Name="RealmDistributionExpander" Header="전체 경지 분포" Margin="0,16,0,0" IsExpanded="True" Expanded="VisibleExpander_Expanded">
                                    <DataGrid x:Name="RealmDistributionGrid" Height="250" Margin="0,6,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="경지" Binding="{Binding Label}" Width="*" />
                                            <DataGridTextColumn Header="인원" Binding="{Binding Count}" Width="72" />
                                            <DataGridTextColumn Header="비율" Binding="{Binding Ratio}" Width="64" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                                <Expander x:Name="PowerDistributionExpander" Header="전체 전투력 분포" Margin="0,12,0,0" IsExpanded="False" Expanded="VisibleExpander_Expanded">
                                    <DataGrid x:Name="PowerDistributionGrid" Height="250" Margin="0,6,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="전투력 구간" Binding="{Binding Label}" Width="*" />
                                            <DataGridTextColumn Header="인원" Binding="{Binding Count}" Width="72" />
                                            <DataGridTextColumn Header="비율" Binding="{Binding Ratio}" Width="64" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="도시">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <StackPanel Margin="16,14,16,12">
                                <TextBlock Text="만상성 도시 상세" Foreground="{StaticResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="도시는 임무 납품 재료를 공동 시장에 공급하고 재료·영석으로 상품을 생산합니다."
                                           Margin="0,8,0,16" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" />
                                <TextBlock Text="도시 금고" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityTreasuryText" Margin="0,4,0,14" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="시장 거래" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityTransactionText" Margin="0,4,0,14" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="임무·재료 가공" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityMissionText" Margin="0,4,0,14" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="도시 생산" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityProductionText" Margin="0,4,0,14" Foreground="{StaticResource PositiveBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="유한 영석 광맥" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityMiningText" Margin="0,4,0,14" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="수요 기반 제작 중" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityProductionQueueText"
                                           Margin="0,4,0,14"
                                           Padding="9"
                                           Background="{StaticResource PanelAltBrush}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="공동 시장 재고" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityInventoryText" Margin="0,4,0,14" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="누적 공급·수요" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityFlowText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="시장">
                        <local:MarketObservationView x:Name="MarketObservationPanel" />
                    </TabItem>
                    <TabItem Header="지도">
                        <local:MapObservationView x:Name="MapObservationPanel"
                                                  ObservationRequested="MapObservationPanel_ObservationRequested"
                                                  AgentSelected="MapObservationPanel_AgentSelected" />
                    </TabItem>
                    <TabItem Header="기록">
                        <local:WorldRecordsView x:Name="WorldRecordsPanel"
                                                ObservationRequested="WorldRecordsPanel_ObservationRequested"
                                                AutoOutputChanged="WorldRecordsPanel_AutoOutputChanged"
                                                WorldExportRequested="WorldRecordsPanel_WorldExportRequested"
                                                DebugExportRequested="WorldRecordsPanel_DebugExportRequested"
                                                FolderOpenRequested="WorldRecordsPanel_FolderOpenRequested" />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border x:Name="WorkspaceUnavailablePanel"
                Grid.Row="4"
                Grid.Column="2"
                Style="{StaticResource PanelStyle}"
                Visibility="Collapsed">
            <Grid>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="520">
                    <TextBlock x:Name="WorkspaceUnavailableTitleText"
                               Text="준비 중"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="WorkspaceUnavailableDescriptionText"
                               Margin="0,12,0,0"
                               Text="이 작업공간에는 아직 표시할 권위 데이터가 없습니다."
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="12,9"
                            Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <TextBlock Text="임시 통계나 추정값을 만들지 않고, 정식 이식 완료 후 실제 데이터만 표시합니다."
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <local:SettingsWorkspaceView x:Name="SettingsWorkspacePanel"
                                     Grid.Row="4"
                                     Grid.Column="2"
                                     Visibility="Collapsed"
                                     UiScaleRequested="SettingsWorkspacePanel_UiScaleRequested"
                                     RestoreWindowRequested="SettingsWorkspacePanel_RestoreWindowRequested"
                                     MaximizeWindowRequested="SettingsWorkspacePanel_MaximizeWindowRequested"
                                     PerformanceMeterChanged="SettingsWorkspacePanel_PerformanceMeterChanged"
                                     NewWorldRequested="SettingsWorkspacePanel_NewWorldRequested" />

        <Grid Grid.Row="6" Grid.Column="2">
            <TextBlock x:Name="StatusText"
                       Text="세계 초기화 중…"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="11" />
            <TextBlock Text="관찰은 세계 상태와 전투 결과에 영향을 주지 않습니다."
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="11" />
        </Grid>
    </Grid>
</Window>
