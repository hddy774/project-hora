<Window x:Class="Chronicles.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Chronicles.Desktop"
        Title="선로만상록 PC"
        Width="1720"
        Height="1000"
        MinWidth="1280"
        MinHeight="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Malgun Gothic"
        FontSize="14"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="RootLayoutGrid" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="94" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="7"
                Grid.Column="0"
                Style="{StaticResource PanelStyle}"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="4,4,4,0">
                    <TextBlock Text="관찰 작업공간"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="열린 경로만 갱신"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10" />
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <RadioButton GroupName="WorkspaceRoute"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 Margin="0,0,0,5"
                                 HorizontalContentAlignment="Left"
                                 IsChecked="True"
                                 Tag="World"
                                 Click="WorkspaceNavigation_Click">세계</RadioButton>
                    <RadioButton GroupName="WorkspaceRoute"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 Margin="0,0,0,5"
                                 HorizontalContentAlignment="Left"
                                 Tag="People"
                                 Click="WorkspaceNavigation_Click">인물</RadioButton>
                    <RadioButton GroupName="WorkspaceRoute"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 Margin="0,0,0,5"
                                 HorizontalContentAlignment="Left"
                                 Tag="Relations"
                                 Click="WorkspaceNavigation_Click">관계</RadioButton>
                    <RadioButton GroupName="WorkspaceRoute"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 Margin="0,0,0,5"
                                 HorizontalContentAlignment="Left"
                                 Tag="Map"
                                 Click="WorkspaceNavigation_Click">지도</RadioButton>
                    <RadioButton GroupName="WorkspaceRoute"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 Margin="0,0,0,5"
                                 HorizontalContentAlignment="Left"
                                 Tag="Economy"
                                 Click="WorkspaceNavigation_Click">경제</RadioButton>
                    <RadioButton GroupName="WorkspaceRoute"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 Margin="0,0,0,5"
                                 HorizontalContentAlignment="Left"
                                 Tag="Organizations"
                                 Click="WorkspaceNavigation_Click">조직</RadioButton>
                    <RadioButton GroupName="WorkspaceRoute"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 Margin="0,0,0,5"
                                 HorizontalContentAlignment="Left"
                                 Tag="Content"
                                 Click="WorkspaceNavigation_Click">콘텐츠</RadioButton>
                    <RadioButton GroupName="WorkspaceRoute"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 Margin="0,0,0,5"
                                 HorizontalContentAlignment="Left"
                                 Tag="Records"
                                 Click="WorkspaceNavigation_Click">기록</RadioButton>
                    <RadioButton GroupName="WorkspaceRoute"
                                  Style="{StaticResource SegmentToggleStyle}"
                                  Margin="0,0,0,5"
                                  HorizontalContentAlignment="Left"
                                  Tag="Diagnostics"
                                  Click="WorkspaceNavigation_Click">진단</RadioButton>
                    <RadioButton GroupName="WorkspaceRoute"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 HorizontalContentAlignment="Left"
                                 Tag="Settings"
                                 Click="WorkspaceNavigation_Click">설정</RadioButton>
                </StackPanel>
                <TextBlock Grid.Row="3"
                           Text="관찰 전용 · 개발자 조정은 새 세계에만 적용"
                           Margin="4,0,4,4"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="9"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="선로만상록"
                           Foreground="{StaticResource PrimaryTextBrush}"
                            FontSize="32"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText"
                           Text="만상경 · 10,000명의 자율 경쟁 관찰"
                           Margin="1,5,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13" />
                <TextBlock x:Name="VersionText"
                           Margin="1,3,0,0"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="세계 시간"
                           Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="WorldTickText"
                           Width="150"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <Button x:Name="PauseButton" Margin="14,0,7,0" Click="PauseButton_Click">일시정지</Button>
                <Button Margin="0,0,5,0" Click="SaveButton_Click">저장</Button>
                <Button Margin="0,0,12,0" Click="LoadButton_Click">불러오기</Button>
                <RadioButton x:Name="Speed1Toggle" GroupName="SimulationSpeed" Style="{StaticResource SegmentToggleStyle}" Margin="0,0,5,0" IsChecked="True" Click="Speed1Button_Click">1×</RadioButton>
                <RadioButton GroupName="SimulationSpeed" Style="{StaticResource SegmentToggleStyle}" Margin="0,0,5,0" Click="Speed10Button_Click">10×</RadioButton>
                <RadioButton GroupName="SimulationSpeed" Style="{StaticResource SegmentToggleStyle}" Margin="0,0,5,0" Click="Speed25Button_Click">25×</RadioButton>
                <RadioButton GroupName="SimulationSpeed" Style="{StaticResource SegmentToggleStyle}" Margin="0,0,5,0" Click="Speed50Button_Click">50×</RadioButton>
                <RadioButton GroupName="SimulationSpeed" Style="{StaticResource SegmentToggleStyle}" Click="Speed100Button_Click">100×</RadioButton>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Grid.Column="2" Rows="1" Columns="5">
            <Border Style="{StaticResource PanelStyle}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="현재 인구" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="PopulationText" Margin="0,5,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="진행 중 전투" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="ActiveCombatText" Margin="0,5,0,0" Foreground="{StaticResource DangerBrush}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="완료된 전투" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="CompletedCombatText" Margin="0,5,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="상위권 도전" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="ChallengeText" Margin="0,5,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="경지 돌파" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="BreakthroughText" Margin="0,5,0,0" Foreground="{StaticResource PositiveBrush}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid x:Name="DashboardWorkspaceGrid" Grid.Row="4" Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspaceListColumn" Width="430" />
                <ColumnDefinition x:Name="WorkspaceListGapColumn" Width="14" />
                <ColumnDefinition x:Name="WorkspaceDetailColumn" Width="*" />
                <ColumnDefinition x:Name="WorkspaceContextGapColumn" Width="14" />
                <ColumnDefinition x:Name="WorkspaceContextColumn" Width="365" />
            </Grid.ColumnDefinitions>

            <Border x:Name="WorkspaceListPanel" Style="{StaticResource PanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,14,16,10">
                        <TextBlock x:Name="RankingTitleText"
                                   Text="전투력 랭킹"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="RankingScopeText"
                                   Text="TOP 1,000"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" />
                    </Grid>
                    <UniformGrid Grid.Row="1" Rows="1" Columns="5" Margin="16,0,16,10">
                        <RadioButton GroupName="RankingMode" Style="{StaticResource SegmentToggleStyle}" Margin="0,0,3,0" IsChecked="True" Click="CombatPowerRankingButton_Click">전투력</RadioButton>
                        <RadioButton GroupName="RankingMode" Style="{StaticResource SegmentToggleStyle}" Margin="3,0" Click="RealmRankingButton_Click">경지</RadioButton>
                        <RadioButton GroupName="RankingMode" Style="{StaticResource SegmentToggleStyle}" Margin="3,0" Click="AptitudeRankingButton_Click">자질</RadioButton>
                        <RadioButton GroupName="RankingMode" Style="{StaticResource SegmentToggleStyle}" Margin="3,0" Click="WealthRankingButton_Click">부자</RadioButton>
                        <RadioButton GroupName="RankingMode" Style="{StaticResource SegmentToggleStyle}" Margin="3,0,0,0" Click="ExplorerButton_Click">전체 탐색</RadioButton>
                    </UniformGrid>
                    <TextBox x:Name="SearchTextBox"
                             Grid.Row="2"
                             Margin="16,0,16,12"
                             TextChanged="SearchTextBox_TextChanged"
                             IsEnabled="False"
                             ToolTip="이름 또는 A00001 형식으로 검색" />
                    <DataGrid x:Name="RankingGrid"
                              Grid.Row="3"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              EnableRowVirtualization="True"
                              SelectionChanged="RankingGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="44" />
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="경지" Binding="{Binding Realm}" Width="140" />
                            <DataGridTextColumn Header="전투력" Binding="{Binding Score}" Width="78" />
                            <DataGridTextColumn Header="상태" Binding="{Binding Activity}" Width="78" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="ExplorerNavigationPanel"
                                Grid.Row="4"
                                Margin="16,10,16,14"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <Button x:Name="ExplorerPreviousButton"
                                Width="58"
                                Click="ExplorerPreviousButton_Click">이전</Button>
                        <TextBlock x:Name="ExplorerPageText"
                                   Width="130"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button x:Name="ExplorerNextButton"
                                Width="58"
                                Click="ExplorerNextButton_Click">다음</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="WorkspaceDetailPanel" Grid.Column="2" Style="{StaticResource PanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedNameText"
                                           Text="인물을 선택하세요"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedIdText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock x:Name="IdentityText"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="12,7"
                                    CornerRadius="16"
                                    Background="{StaticResource AccentDarkBrush}"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="SelectedRankText"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="0.65*" />
                                <ColumnDefinition Width="0.85*" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="경지" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="RealmText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="15"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="나이 / 수명" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="AgeText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="15"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="생" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="LifeText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="0,0,12,0">
                                <TextBlock Text="현재 행동" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="ActivityText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="상대" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="OpponentText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ActionScheduleText"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LocationText"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource PositiveBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <Expander x:Name="DecisionReasonExpander"
                                  Header="현재 목표·행동 선택 이유"
                                  Margin="0,10,0,0"
                                  IsExpanded="False"
                                  Expanded="VisibleExpander_Expanded">
                            <TextBlock x:Name="DecisionReasonText"
                                       Margin="0,7,0,0"
                                       Padding="10"
                                       Background="{StaticResource PanelAltBrush}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Expander>
                        <Expander x:Name="LifeAuthorityExpander"
                                  Header="생애·육신·외형 권위"
                                  Margin="0,8,0,0"
                                  IsExpanded="False"
                                  Expanded="VisibleExpander_Expanded">
                            <TextBlock x:Name="LifeAuthorityText"
                                       Margin="0,7,0,0"
                                       Padding="10"
                                       Background="{StaticResource PanelAltBrush}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Expander>
                        <Expander x:Name="CausalRuntimeExpander"
                                  Header="인과선·인지 사실·현재 생 기억"
                                  Margin="0,8,0,0"
                                  IsExpanded="False"
                                  Expanded="VisibleExpander_Expanded">
                            <TextBlock x:Name="CausalRuntimeText"
                                       Margin="0,7,0,0"
                                       Padding="10"
                                       Background="{StaticResource PanelAltBrush}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Expander>
                        <Expander x:Name="RelationsExpander"
                                  Header="관계 6축·역할·중요 역사"
                                  Margin="0,8,0,0"
                                  IsExpanded="False"
                                  Expanded="VisibleExpander_Expanded">
                            <TextBlock x:Name="RelationsText"
                                       Margin="0,7,0,0"
                                       Padding="10"
                                       Background="{StaticResource PanelAltBrush}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Expander>
                        <Expander x:Name="TeachingExpander"
                                  Header="사제·가르침·전승 추적"
                                  Margin="0,8,0,0"
                                  IsExpanded="False"
                                  Expanded="VisibleExpander_Expanded">
                            <TextBlock x:Name="TeachingText"
                                       Margin="0,7,0,0"
                                       Padding="10"
                                       Background="{StaticResource PanelAltBrush}"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Expander>

                        <TextBlock Text="수행 진척"
                                   Margin="0,24,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" />
                        <ProgressBar x:Name="CultivationProgressBar"
                                     Margin="0,8,0,0"
                                     Height="9"
                                     Foreground="{StaticResource PositiveBrush}"
                                     Background="{StaticResource PanelAltBrush}" />
                        <TextBlock x:Name="CultivationText"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11" />
                        <TextBlock x:Name="CultivationStateText"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,8,0,0"
                                Padding="10"
                                CornerRadius="7"
                                Background="{StaticResource PanelAltBrush}">
                            <StackPanel>
                                <TextBlock x:Name="CultivationAuthorityText"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="CultivationComponentText"
                                           Margin="0,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                                <Expander x:Name="CultivationTraceExpander"
                                          Header="최근 수행 Formula Trace"
                                          Margin="0,8,0,0"
                                          IsExpanded="False"
                                          Expanded="VisibleExpander_Expanded">
                                    <TextBlock x:Name="CultivationTraceText"
                                               Margin="4,6,4,2"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="선천 자질"
                                   Margin="0,24,0,10"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <UniformGrid Rows="2" Columns="3">
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="영근" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="RootText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="근골" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="BoneText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="체질" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="ConstitutionText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="0,10,5,0">
                                <StackPanel>
                                    <TextBlock Text="오성" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="ComprehensionText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="5,10,5,0">
                                <StackPanel>
                                    <TextBlock Text="정신" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="MindText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="5,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="영혼" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="SoulText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Expander x:Name="AptitudeDetailsExpander"
                                  Header="세부 선천자질 · F-TRAIT-002"
                                  Margin="0,12,0,0"
                                  IsExpanded="False"
                                  Expanded="VisibleExpander_Expanded">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="대표값은 각 영역의 세부 Component 10개 평균입니다. 생성 편차 계수는 다음 버전 재검토 대상입니다."
                                           Margin="4,0,4,8"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                                <TabControl x:Name="AptitudeDetailTabControl"
                                            Background="{StaticResource PanelAltBrush}"
                                            BorderThickness="0"
                                            SelectionChanged="AptitudeDetailTabControl_SelectionChanged">
                                    <TabItem Header="영근">
                                        <TextBlock x:Name="RootDetailText" Padding="10" TextWrapping="Wrap" />
                                    </TabItem>
                                    <TabItem Header="근골">
