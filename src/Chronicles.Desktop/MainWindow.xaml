<Window x:Class="Chronicles.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="선로만상록 PC"
        Width="1500"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Malgun Gothic"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="82" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="선로만상록"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="29"
                           FontWeight="SemiBold" />
                <TextBlock Text="만상경 · 10,000명의 자율 경쟁 관찰"
                           Margin="1,5,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="13" />
                <TextBlock x:Name="VersionText"
                           Margin="1,3,0,0"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="세계 시간"
                           Margin="0,0,9,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock x:Name="WorldTickText"
                           Width="150"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <Button x:Name="PauseButton" Margin="14,0,7,0" Click="PauseButton_Click">일시정지</Button>
                <Button Margin="0,0,5,0" Click="SaveButton_Click">저장</Button>
                <Button Margin="0,0,12,0" Click="LoadButton_Click">불러오기</Button>
                <Button Margin="0,0,5,0" Click="Speed1Button_Click">1×</Button>
                <Button Margin="0,0,5,0" Click="Speed10Button_Click">10×</Button>
                <Button Margin="0,0,5,0" Click="Speed25Button_Click">25×</Button>
                <Button Margin="0,0,5,0" Click="Speed50Button_Click">50×</Button>
                <Button Click="Speed100Button_Click">100×</Button>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="2" Rows="1" Columns="5">
            <Border Style="{StaticResource PanelStyle}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="현재 인구" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="PopulationText" Margin="0,5,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="진행 중 전투" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="ActiveCombatText" Margin="0,5,0,0" Foreground="{StaticResource DangerBrush}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="완료된 전투" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="CompletedCombatText" Margin="0,5,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Margin="7,0">
                <StackPanel>
                    <TextBlock Text="상위권 도전" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="ChallengeText" Margin="0,5,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PanelStyle}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="경지 돌파" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                    <TextBlock x:Name="BreakthroughText" Margin="0,5,0,0" Foreground="{StaticResource PositiveBrush}" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="365" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,14,16,10">
                        <TextBlock x:Name="RankingTitleText"
                                   Text="전투력 랭킹"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="RankingScopeText"
                                   Text="TOP 1,000"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" />
                    </Grid>
                    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="16,0,16,10">
                        <Button Margin="0,0,3,0" Click="CombatPowerRankingButton_Click">전투력</Button>
                        <Button Margin="3,0" Click="RealmRankingButton_Click">경지</Button>
                        <Button Margin="3,0" Click="AptitudeRankingButton_Click">자질</Button>
                        <Button Margin="3,0,0,0" Click="ExplorerButton_Click">전체 탐색</Button>
                    </UniformGrid>
                    <TextBox x:Name="SearchTextBox"
                             Grid.Row="2"
                             Margin="16,0,16,12"
                             TextChanged="SearchTextBox_TextChanged"
                             IsEnabled="False"
                             ToolTip="이름 또는 A00001 형식으로 검색" />
                    <DataGrid x:Name="RankingGrid"
                              Grid.Row="3"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              EnableRowVirtualization="True"
                              SelectionChanged="RankingGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="44" />
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="경지" Binding="{Binding Realm}" Width="140" />
                            <DataGridTextColumn Header="전투력" Binding="{Binding Score}" Width="78" />
                            <DataGridTextColumn Header="상태" Binding="{Binding Activity}" Width="78" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="ExplorerNavigationPanel"
                                Grid.Row="4"
                                Margin="16,10,16,14"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <Button x:Name="ExplorerPreviousButton"
                                Width="58"
                                Click="ExplorerPreviousButton_Click">이전</Button>
                        <TextBlock x:Name="ExplorerPageText"
                                   Width="130"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                        <Button x:Name="ExplorerNextButton"
                                Width="58"
                                Click="ExplorerNextButton_Click">다음</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="SelectedNameText"
                                           Text="인물을 선택하세요"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="24"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedIdText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="12,7"
                                    CornerRadius="16"
                                    Background="{StaticResource AccentDarkBrush}"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="SelectedRankText"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="경지" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="RealmText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="나이 / 수명" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="AgeText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="생" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="LifeText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="현재 행동" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="ActivityText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="상대" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="OpponentText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ActionScheduleText"
                                   Margin="0,8,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="LocationText"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource PositiveBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="수행 진척"
                                   Margin="0,24,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="12" />
                        <ProgressBar x:Name="CultivationProgressBar"
                                     Margin="0,8,0,0"
                                     Height="9"
                                     Foreground="{StaticResource PositiveBrush}"
                                     Background="{StaticResource PanelAltBrush}" />
                        <TextBlock x:Name="CultivationText"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11" />
                        <TextBlock x:Name="CultivationStateText"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,8,0,0"
                                Padding="10"
                                CornerRadius="7"
                                Background="{StaticResource PanelAltBrush}">
                            <StackPanel>
                                <TextBlock x:Name="CultivationAuthorityText"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="CultivationComponentText"
                                           Margin="0,5,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="10"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="선천 자질"
                                   Margin="0,24,0,10"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <UniformGrid Rows="2" Columns="3">
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="영근" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="RootText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="근골" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="BoneText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="체질" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="ConstitutionText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="0,10,5,0">
                                <StackPanel>
                                    <TextBlock Text="오성" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="ComprehensionText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="5,10,5,0">
                                <StackPanel>
                                    <TextBlock Text="정신" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="MindText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="10" Margin="5,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="영혼" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                    <TextBlock x:Name="SoulText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="19" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="공법" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="TechniqueText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="법술" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="SpellText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="14" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="생명력" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="HealthText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="영력" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="QiText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="전적 / 경험" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="RecordText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="실전 전투 속성 · 표시 전투력과 별도 계산"
                                   Margin="0,22,0,8"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <Border Padding="10"
                                CornerRadius="7"
                                Background="{StaticResource PanelAltBrush}">
                            <StackPanel>
                                <TextBlock x:Name="CombatAttributeText"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="InjuryText"
                                           Margin="0,6,0,0"
                                           Foreground="{StaticResource DangerBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="도시 경제·법보"
                                   Margin="0,24,0,10"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <UniformGrid Rows="1" Columns="4">
                            <StackPanel>
                                <TextBlock Text="영석" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="SpiritStoneText" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="단약" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="PillInventoryText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="도시 임무" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="MissionText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="보유 재료" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="MaterialText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="EquipmentText"
                                   Margin="0,10,0,0"
                                   Padding="10"
                                   Background="{StaticResource PanelAltBrush}"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="MaterialDetailText"
                                   Margin="0,8,0,0"
                                   Padding="10"
                                   Background="{StaticResource PanelAltBrush}"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,26,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="전투력 구성"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="TotalPowerText"
                                       Grid.Column="1"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="18"
                                       FontWeight="Bold" />
                        </Grid>
                        <Grid Margin="0,13,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="경지" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ProgressBar x:Name="RealmPowerBar" Grid.Column="1" Style="{StaticResource PowerBarStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RealmPowerText" Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryTextBrush}" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <TextBlock Text="자질" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ProgressBar x:Name="AptitudePowerBar" Grid.Column="1" Style="{StaticResource PowerBarStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="AptitudePowerText" Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryTextBrush}" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <TextBlock Text="공법" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ProgressBar x:Name="TechniquePowerBar" Grid.Column="1" Style="{StaticResource PowerBarStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TechniquePowerText" Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryTextBrush}" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <TextBlock Text="법술" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ProgressBar x:Name="SpellPowerBar" Grid.Column="1" Style="{StaticResource PowerBarStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SpellPowerText" Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryTextBrush}" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <TextBlock Text="경험" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ProgressBar x:Name="ExperiencePowerBar" Grid.Column="1" Style="{StaticResource PowerBarStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ExperiencePowerText" Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryTextBrush}" />
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
                            <TextBlock Text="법보" Foreground="{StaticResource SecondaryTextBrush}" />
                            <ProgressBar x:Name="TreasurePowerBar" Grid.Column="1" Style="{StaticResource PowerBarStyle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TreasurePowerText" Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryTextBrush}" />
                        </Grid>

                        <TabControl x:Name="AgentLogTabControl"
                                    Margin="0,28,0,0"
                                    Height="300"
                                    Background="{StaticResource PanelAltBrush}"
                                    BorderThickness="0"
                                    SelectionChanged="VisibleSection_SelectionChanged">
                            <TabItem Header="최근 개인 로그 · 최대 100줄">
                                <ListBox x:Name="PersonalLogList"
                                         Background="{StaticResource PanelAltBrush}"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                                    <TextBlock Text="{Binding Summary}" Margin="0,3,0,0" Foreground="{Binding Color}" TextWrapping="Wrap" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                            <TabItem Header="영구 연대기">
                                <ListBox x:Name="ChronicleList"
                                         Background="{StaticResource PanelAltBrush}"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,9">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                                    <TextBlock Text="{Binding Summary}" Margin="0,3,0,0" Foreground="{Binding Color}" TextWrapping="Wrap" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource PanelStyle}" Padding="0">
                <TabControl x:Name="WorldInfoTabControl"
                            Background="Transparent"
                            BorderThickness="0"
                            SelectionChanged="VisibleSection_SelectionChanged">
                    <TabItem Header="통계">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,14,16,12">
                                <TextBlock Text="전체 세계 통계"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <UniformGrid Rows="2" Columns="3" Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,5,8">
                                        <TextBlock Text="사망" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="DeathStatText" Foreground="{StaticResource DangerBrush}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel Margin="5,0,5,8">
                                        <TextBlock Text="승리" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="WinStatText" Foreground="{StaticResource PositiveBrush}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel Margin="5,0,0,8">
                                        <TextBlock Text="패배" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="LossStatText" Foreground="{StaticResource DangerBrush}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,5,0">
                                        <TextBlock Text="윤회" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="ReincarnationStatText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel Margin="5,0,5,0">
                                        <TextBlock Text="임무 완료" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="MissionStatText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" />
                                    </StackPanel>
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="보유 영석" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="SpiritStoneStatText" Foreground="{StaticResource AccentBrush}" FontSize="15" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="전투력 랭킹 변동" Margin="0,16,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="RankingMovementText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <Expander x:Name="RealmDistributionExpander" Header="전체 경지 분포" Margin="0,16,0,0" IsExpanded="True" Expanded="VisibleExpander_Expanded">
                                    <DataGrid x:Name="RealmDistributionGrid" Height="250" Margin="0,6,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="경지" Binding="{Binding Label}" Width="*" />
                                            <DataGridTextColumn Header="인원" Binding="{Binding Count}" Width="72" />
                                            <DataGridTextColumn Header="비율" Binding="{Binding Ratio}" Width="64" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                                <Expander x:Name="PowerDistributionExpander" Header="전체 전투력 분포" Margin="0,12,0,0" IsExpanded="False" Expanded="VisibleExpander_Expanded">
                                    <DataGrid x:Name="PowerDistributionGrid" Height="250" Margin="0,6,0,0" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="전투력 구간" Binding="{Binding Label}" Width="*" />
                                            <DataGridTextColumn Header="인원" Binding="{Binding Count}" Width="72" />
                                            <DataGridTextColumn Header="비율" Binding="{Binding Ratio}" Width="64" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="도시">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,14,16,12">
                                <TextBlock Text="만상경 도시 상세" Foreground="{StaticResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="도시는 임무 납품 재료를 공동 시장에 공급하고 재료·영석으로 상품을 생산합니다."
                                           Margin="0,8,0,16" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" />
                                <TextBlock Text="도시 금고" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityTreasuryText" Margin="0,4,0,14" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="시장 거래" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityTransactionText" Margin="0,4,0,14" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="임무·재료 가공" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityMissionText" Margin="0,4,0,14" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="도시 생산" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityProductionText" Margin="0,4,0,14" Foreground="{StaticResource PositiveBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="공동 시장 재고" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityInventoryText" Margin="0,4,0,14" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="누적 공급·수요" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                                <TextBlock x:Name="CityFlowText" Margin="0,4,0,0" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="시장">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="4,2,4,10">
                                <TextBlock Text="35개 상품 공급·수요·가격" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="MarketTreasuryText" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <DataGrid x:Name="MarketGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      EnableRowVirtualization="True"
                                      SelectionMode="Single"
                                      SelectionChanged="MarketGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="상품" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="기준" Binding="{Binding BasePrice}" Width="52" />
                                    <DataGridTextColumn Header="현재" Binding="{Binding CurrentPrice}" Width="52" />
                                    <DataGridTextColumn Header="변동" Binding="{Binding Change}" Width="54" />
                                    <DataGridTextColumn Header="재고" Binding="{Binding Stock}" Width="46" />
                                    <DataGridTextColumn Header="공급" Binding="{Binding Supply}" Width="52" />
                                    <DataGridTextColumn Header="수요" Binding="{Binding Demand}" Width="52" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Expander x:Name="MarketDetailExpander" Grid.Row="2" Header="선택 상품 상세" Margin="0,10,0,0" IsExpanded="True" Expanded="VisibleExpander_Expanded">
                                <Border Margin="0,6,0,0"
                                        Padding="12"
                                        CornerRadius="7"
                                        Background="{StaticResource PanelAltBrush}">
                                    <StackPanel>
                                    <TextBlock x:Name="MarketDetailNameText"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="MarketDetailTypeText"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="11" />
                                    <TextBlock x:Name="MarketDetailDescriptionText"
                                               Margin="0,8,0,0"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="MarketDetailProductionText"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="MarketDetailEconomyText"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource PositiveBrush}"
                                               FontSize="11"
                                               TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </Grid>
                    </TabItem>
                    <TabItem Header="지도">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,14,14,12">
                                <TextBlock Text="만상경 3×3 세계 지도"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="17"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="MapSummaryText"
                                           Margin="0,5,0,12"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <ItemsControl x:Name="MapTileList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="3" Columns="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="3"
                                                    Padding="7"
                                                    MinHeight="92"
                                                    CornerRadius="6"
                                                    Background="{Binding Background}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               TextAlignment="Center" />
                                                    <TextBlock Text="{Binding Biome}"
                                                               Margin="0,3,0,0"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontSize="10"
                                                               TextAlignment="Center" />
                                                    <TextBlock Text="{Binding Population}"
                                                               Margin="0,4,0,0"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="10"
                                                               TextAlignment="Center" />
                                                    <TextBlock Text="{Binding Monsters}"
                                                               Margin="0,3,0,0"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="9"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Expander x:Name="MapLocationExpander" Header="지역 상세 목록" Margin="0,14,0,0" IsExpanded="False" Expanded="VisibleExpander_Expanded">
                                    <DataGrid x:Name="MapLocationGrid"
                                              Height="275"
                                              Margin="0,6,0,0"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              EnableRowVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="지역" Binding="{Binding Name}" Width="78" />
                                            <DataGridTextColumn Header="지형" Binding="{Binding Biome}" Width="55" />
                                            <DataGridTextColumn Header="좌표" Binding="{Binding Coordinates}" Width="48" />
                                            <DataGridTextColumn Header="인구" Binding="{Binding Population}" Width="58" />
                                            <DataGridTextColumn Header="서식 요수" Binding="{Binding Monsters}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="세계 로그">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="16,14,16,10">
                                <TextBlock Text="중요 세계 로그" Foreground="{StaticResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="최대 100줄" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" FontSize="11" FontWeight="Bold" />
                            </Grid>
                            <ListBox x:Name="EventList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryTextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,11">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Time}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                                <TextBlock Text="{Binding Summary}" Margin="0,4,0,0" Foreground="{Binding Color}" TextWrapping="Wrap" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Grid Grid.Row="6">
            <TextBlock x:Name="StatusText"
                       Text="세계 초기화 중…"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="11" />
            <TextBlock Text="관찰은 세계 상태와 전투 결과에 영향을 주지 않습니다."
                       HorizontalAlignment="Right"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="11" />
        </Grid>
    </Grid>
</Window>
