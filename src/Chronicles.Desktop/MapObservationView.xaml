<UserControl x:Class="Chronicles.Desktop.MapObservationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="270" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,2,4,9">
            <TextBlock Text="만상경 지역 관찰"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="MapSummaryText"
                       Margin="0,3,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="10"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ItemsControl x:Name="MapTileList" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Tag="{Binding LocationId}"
                            Click="MapTileButton_Click"
                            Margin="0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Border Margin="3"
                                Padding="6"
                                CornerRadius="6"
                                BorderBrush="{Binding Border}"
                                BorderThickness="2"
                                Background="{Binding Background}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding Biome}"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="9"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding Population}"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="10"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding Summary}"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="8"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2"
                Margin="3,8,3,7"
                Padding="10,8"
                CornerRadius="7"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                Background="{StaticResource PanelAltBrush}">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="RegionTitleText"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="RegionSubtitleText"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="선택 지역"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="9"
                           FontWeight="Bold" />
            </Grid>
        </Border>

        <TabControl x:Name="RegionTabControl"
                    Grid.Row="3"
                    SelectionChanged="RegionTabControl_SelectionChanged">
            <TabItem Header="지역 개요">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <UniformGrid Columns="2">
                            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="수선자" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                    <TextBlock x:Name="RegionPopulationText" Margin="0,2,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="최고 경지" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                    <TextBlock x:Name="RegionHighestRealmText" Margin="0,2,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="평균 전투력" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                    <TextBlock x:Name="RegionAveragePowerText" Margin="0,2,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="최고 전투력" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                    <TextBlock x:Name="RegionMaximumPowerText" Margin="0,2,0,0" Foreground="{StaticResource PositiveBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="현재 행동 분포" Margin="3,8,3,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                        <TextBlock x:Name="RegionActivityText" Margin="3,3" Foreground="{StaticResource PrimaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                        <Button x:Name="StrongestAgentButton"
                                Margin="3,7,3,0"
                                HorizontalContentAlignment="Left"
                                Click="StrongestAgentButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="요수 생태">
                <Grid Margin="8">
                    <TextBlock x:Name="SafeRegionText"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PositiveBrush}"
                               Text="안전지대 · 서식 요수 없음" />
                    <DataGrid x:Name="MonsterGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="요수" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="개체" Binding="{Binding Population}" Width="60" />
                            <DataGridTextColumn Header="위험" Binding="{Binding Danger}" Width="64" />
                            <DataGridTextColumn Header="전리품" Binding="{Binding Drop}" Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="수선자">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PreviousAgentPageButton" Content="이전" Padding="8,4" Click="PreviousAgentPageButton_Click" />
                            <Button x:Name="NextAgentPageButton" Content="다음" Margin="5,0,0,0" Padding="8,4" Click="NextAgentPageButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="AgentPageText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="9" />
                    </Grid>
                    <DataGrid x:Name="MapAgentGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              EnableRowVirtualization="True"
                              SelectionMode="Single"
                              SelectionChanged="MapAgentGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="48" />
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="경지" Binding="{Binding Realm}" Width="112" />
                            <DataGridTextColumn Header="전투력" Binding="{Binding CombatPower}" Width="68" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
