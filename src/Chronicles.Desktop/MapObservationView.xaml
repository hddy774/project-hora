<UserControl x:Class="Chronicles.Desktop.MapObservationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320">
    <TabControl x:Name="MapModeTabControl"
                Background="Transparent"
                BorderThickness="0"
                SelectionChanged="MapModeTabControl_SelectionChanged">
        <TabItem Header="지역 활동">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="270" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="4,2,4,9">
            <TextBlock Text="만상경 지역 관찰"
                       Foreground="{StaticResource PrimaryTextBrush}"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="MapSummaryText"
                       Margin="0,3,0,0"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="10"
                       TextWrapping="Wrap" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <RadioButton GroupName="HeavenlyLayer"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 IsChecked="True"
                                 Tag="1"
                                 Click="HeavenlyLayerButton_Click">제1층천</RadioButton>
                    <RadioButton GroupName="HeavenlyLayer"
                                 Style="{StaticResource SegmentToggleStyle}"
                                 Margin="5,0,0,0"
                                 Tag="2"
                                 Click="HeavenlyLayerButton_Click">제2층천</RadioButton>
                </StackPanel>
                <TextBox x:Name="MapSearchBox"
                         Grid.Column="2"
                         TextChanged="MapSearchBox_TextChanged"
                         ToolTip="현재 층천의 지점 이름 검색" />
                <TextBlock Grid.Column="3"
                           Text="제3~5층천 · 개발 중"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="9" />
            </Grid>
        </StackPanel>

        <ItemsControl x:Name="MapTileList" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="3" Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Tag="{Binding LocationId}"
                            Click="MapTileButton_Click"
                            Margin="0"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Border Margin="3"
                                Padding="6"
                                CornerRadius="6"
                                BorderBrush="{Binding Border}"
                                BorderThickness="2"
                                Background="{Binding Background}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding Biome}"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="9"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding Population}"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="10"
                                           TextAlignment="Center" />
                                <TextBlock Text="{Binding Summary}"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="8"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="2"
                Margin="3,8,3,7"
                Padding="10,8"
                CornerRadius="7"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                Background="{StaticResource PanelAltBrush}">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="RegionTitleText"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="RegionSubtitleText"
                               Margin="0,3,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="선택 지역"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="9"
                           FontWeight="Bold" />
            </Grid>
        </Border>

        <TabControl x:Name="RegionTabControl"
                    Grid.Row="3"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    SelectionChanged="RegionTabControl_SelectionChanged">
            <TabItem Header="지역 개요">
                <StackPanel Margin="8">
                        <UniformGrid Columns="2">
                            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="수선자" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                    <TextBlock x:Name="RegionPopulationText" Margin="0,2,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="최고 경지" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                    <TextBlock x:Name="RegionHighestRealmText" Margin="0,2,0,0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="평균 전투력" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                    <TextBlock x:Name="RegionAveragePowerText" Margin="0,2,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="최고 전투력" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                    <TextBlock x:Name="RegionMaximumPowerText" Margin="0,2,0,0" Foreground="{StaticResource PositiveBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="현재 행동 분포" Margin="3,8,3,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                        <TextBlock x:Name="RegionActivityText" Margin="3,3" Foreground="{StaticResource PrimaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                        <Button x:Name="StrongestAgentButton"
                                Margin="3,7,3,0"
                                HorizontalContentAlignment="Left"
                                Click="StrongestAgentButton_Click" />
                </StackPanel>
            </TabItem>
            <TabItem Header="요수 생태">
                <Grid Margin="8">
                    <TextBlock x:Name="SafeRegionText"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PositiveBrush}"
                               Text="안전지대 · 서식 요수 없음" />
                    <DataGrid x:Name="MonsterGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="요수" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="개체" Binding="{Binding Population}" Width="60" />
                            <DataGridTextColumn Header="위험" Binding="{Binding Danger}" Width="64" />
                            <DataGridTextColumn Header="전리품" Binding="{Binding Drop}" Width="72" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="수선자">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PreviousAgentPageButton" Content="이전" Padding="8,4" Click="PreviousAgentPageButton_Click" />
                            <Button x:Name="NextAgentPageButton" Content="다음" Margin="5,0,0,0" Padding="8,4" Click="NextAgentPageButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="AgentPageText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="9" />
                    </Grid>
                    <DataGrid x:Name="MapAgentGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              EnableRowVirtualization="True"
                              SelectionMode="Single"
                              SelectionChanged="MapAgentGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="48" />
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="경지" Binding="{Binding Realm}" Width="112" />
                            <DataGridTextColumn Header="전투력" Binding="{Binding CombatPower}" Width="68" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="계층·영맥">
                <StackPanel Margin="10">
                        <TextBlock Text="Atlas 계층"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="9" />
                        <TextBlock x:Name="AtlasHierarchyText"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,10,0,0"
                                Padding="10"
                                CornerRadius="6"
                                Background="{StaticResource PanelAltBrush}">
                            <StackPanel>
                                <TextBlock Text="안정 Location Ref"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="9" />
                                <TextBlock x:Name="AtlasLocationRefText"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" />
                                <TextBlock Text="영맥 Source / 잔여 공급 / 월 생산력"
                                           Margin="0,9,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="9" />
                                <TextBlock x:Name="SpiritVeinText"
                                           Margin="0,3,0,0"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="층천 구현 상태"
                                   Margin="0,12,0,5"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="9" />
                        <DataGrid x:Name="AtlasLayerGrid"
                                  Height="150"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  EnableRowVirtualization="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="층천" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="88" />
                                <DataGridTextColumn Header="지점" Binding="{Binding Locations}" Width="58" />
                                <DataGridTextColumn Header="인구" Binding="{Binding Population}" Width="78" />
                                <DataGridTextColumn Header="영맥" Binding="{Binding Veins}" Width="68" />
                            </DataGrid.Columns>
                        </DataGrid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
        </TabItem>
        <TabItem Header="대륙 · 주 · 지점">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="190" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.ColumnSpan="3" Margin="3,0,3,9">
                    <StackPanel>
                        <TextBlock Text="하천대륙 지리 관찰"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="GeographySummaryText"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <RadioButton GroupName="GeographyLayer"
                                     Style="{StaticResource SegmentToggleStyle}"
                                     IsChecked="True"
                                     Tag="1"
                                     Click="GeographyLayerButton_Click">제1층천 · 범인계</RadioButton>
                        <RadioButton GroupName="GeographyLayer"
                                     Style="{StaticResource SegmentToggleStyle}"
                                     Margin="5,0,0,0"
                                     Tag="2"
                                     Click="GeographyLayerButton_Click">제2층천 · 수선계</RadioButton>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource PanelStyle}"
                        Padding="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="대륙의 주(권역) 10×10 · 오천주만 상세 구현"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="9" />
                        <ItemsControl x:Name="ProvinceTileList" Grid.Row="1" Margin="0,7,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="10" Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding ProvinceId}"
                                            IsEnabled="{Binding IsEnabled}"
                                            Click="ProvinceTileButton_Click"
                                            Margin="1"
                                            Padding="0"
                                            ToolTip="{Binding ToolTip}"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding Border}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="8"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   TextAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource PanelStyle}"
                        Padding="9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PointGridTitleText"
                                   Text="오천주 지점 10×10"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="9" />
                        <ItemsControl x:Name="PointTileList" Grid.Row="1" Margin="0,7,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="10" Columns="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding PointId}"
                                            Click="PointTileButton_Click"
                                            Margin="1"
                                            Padding="0"
                                            ToolTip="{Binding ToolTip}"
                                            Background="{Binding Background}"
                                            BorderBrush="{Binding Border}"
                                            BorderThickness="1">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="8"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="{Binding Marker}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top"
                                                       Margin="0,-3,1,0"
                                                       FontSize="7"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <TabControl Grid.Row="2"
                            Grid.ColumnSpan="3"
                            Margin="0,10,0,0"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}">
                    <TabItem Header="지점 개요">
                        <Grid Margin="12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PointTitleText"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="PointCoordinateText"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="10" />
                            </StackPanel>
                            <TextBlock x:Name="PointDescriptionText"
                                       Grid.Column="2"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="정착지">
                        <UniformGrid Columns="6" Margin="10,8">
                            <StackPanel><TextBlock Text="사회" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointSocietyText" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="대도시" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointLargeCityText" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="소도시" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointSmallCityText" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="촌" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointVillageText" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="종문" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointSectText" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="가문" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointClanText" Margin="0,3,0,0" /></StackPanel>
                        </UniformGrid>
                    </TabItem>
                    <TabItem Header="자원 · 생령">
                        <UniformGrid Columns="5" Margin="10,8">
                            <StackPanel><TextBlock Text="자연 환경" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointTerrainText" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="영맥" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointVeinText" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="광산" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointMineText" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="영수 추정" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointBeastText" Margin="0,3,0,0" /></StackPanel>
                            <StackPanel><TextBlock Text="인접 이동 거리" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" /><TextBlock x:Name="PointDistanceText" Margin="0,3,0,0" /></StackPanel>
                        </UniformGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
