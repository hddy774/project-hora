<UserControl x:Class="Chronicles.Desktop.MarketObservationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="205" />
        </Grid.RowDefinitions>

        <Grid Margin="4,2,4,10">
            <StackPanel>
                <TextBlock Text="만상성 공동 시장"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Text="분류와 검색으로 상품을 좁힌 뒤 가격·수급·생산을 확인합니다."
                           Margin="0,3,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="10"
                           TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="TreasuryText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource AccentBrush}"
                       FontSize="12"
                       FontWeight="SemiBold" />
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,9">
            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                <StackPanel>
                    <TextBlock Text="전체 재고" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                    <TextBlock x:Name="TotalStockText" Margin="0,2,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                <StackPanel>
                    <TextBlock Text="미충족 수요" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                    <TextBlock x:Name="UnmetDemandText" Margin="0,2,0,0" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Margin="3" Padding="8" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                <StackPanel>
                    <TextBlock Text="제작 중" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                    <TextBlock x:Name="ProductionCountText" Margin="0,2,0,0" Foreground="{StaticResource PositiveBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="2" Margin="3,0,3,8">
            <UniformGrid Columns="5">
                <RadioButton GroupName="MarketFilter" Tag="All" Content="전체" IsChecked="True" Style="{StaticResource SegmentToggleStyle}" Padding="5" Click="MarketFilterButton_Click" />
                <RadioButton GroupName="MarketFilter" Tag="Material" Content="재료" Style="{StaticResource SegmentToggleStyle}" Padding="5" Click="MarketFilterButton_Click" />
                <RadioButton GroupName="MarketFilter" Tag="Pill" Content="단약" Style="{StaticResource SegmentToggleStyle}" Padding="5" Click="MarketFilterButton_Click" />
                <RadioButton GroupName="MarketFilter" Tag="Treasure" Content="법보" Style="{StaticResource SegmentToggleStyle}" Padding="5" Click="MarketFilterButton_Click" />
                <RadioButton GroupName="MarketFilter" Tag="Book" Content="서적" Style="{StaticResource SegmentToggleStyle}" Padding="5" Click="MarketFilterButton_Click" />
            </UniformGrid>
            <TextBox x:Name="SearchBox"
                     Margin="0,6,0,0"
                     Padding="8,5"
                     ToolTip="상품명 또는 대경지 검색"
                     TextChanged="SearchBox_TextChanged" />
        </StackPanel>

        <DataGrid x:Name="MarketGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  EnableRowVirtualization="True"
                  SelectionMode="Single"
                  SelectionChanged="MarketGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="상품" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="현재가" Binding="{Binding CurrentPrice}" Width="76" />
                <DataGridTextColumn Header="재고" Binding="{Binding Stock}" Width="52" />
                <DataGridTextColumn Header="수급" Binding="{Binding Flow}" Width="82" />
            </DataGrid.Columns>
        </DataGrid>

        <TabControl x:Name="DetailTabControl"
                    Grid.Row="4"
                    Margin="0,9,0,0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    SelectionChanged="DetailTabControl_SelectionChanged">
            <TabItem Header="상품 개요">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">
                        <TextBlock x:Name="DetailNameText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="DetailTypeText" Margin="0,3,0,0" Foreground="{StaticResource AccentBrush}" FontSize="10" />
                        <TextBlock x:Name="DetailDescriptionText" Margin="0,8,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailQualityText" Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="가격·수급">
                <StackPanel Margin="10,8">
                    <TextBlock x:Name="DetailPriceText" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailFlowText" Margin="0,8,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailDemandText" Margin="0,7,0,0" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
            </TabItem>
            <TabItem Header="도시 생산">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">
                        <TextBlock x:Name="DetailProductionStateText" Foreground="{StaticResource PositiveBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailProductionText" Margin="0,8,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="10" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
