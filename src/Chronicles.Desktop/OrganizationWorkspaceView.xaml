<UserControl x:Class="Chronicles.Desktop.OrganizationWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Chronicles.Desktop"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelStyle}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="조직 · 종문 · 가문 · 왕조"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="실제 구성원·자산·Atlas 권리만 표시합니다. 열린 내부 탭만 행을 구성합니다."
                               Margin="0,5,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11" />
                </StackPanel>
                <local:ResponsiveCardPanel Grid.Column="1"
                                           VerticalAlignment="Center"
                                           MinimumCardWidth="92"
                                           MaximumColumns="4"
                                           ColumnGap="0"
                                           RowGap="6">
                    <Border Margin="4,0" Padding="13,7" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                        <StackPanel>
                            <TextBlock Text="전체" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                            <TextBlock x:Name="TotalCountText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0" Padding="13,7" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                        <StackPanel>
                            <TextBlock Text="활성 종문" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                            <TextBlock x:Name="SectCountText" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0" Padding="13,7" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                        <StackPanel>
                            <TextBlock Text="활성 가문" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                            <TextBlock x:Name="ClanCountText" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Border Margin="4,0" Padding="13,7" CornerRadius="6" Background="{StaticResource PanelAltBrush}">
                        <StackPanel>
                            <TextBlock Text="활성 왕조" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                            <TextBlock x:Name="DynastyCountText" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </local:ResponsiveCardPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="410" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="조직 탐색"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="17"
                               FontWeight="SemiBold" />
                    <Grid Grid.Row="1" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="98" />
                            <ColumnDefinition Width="98" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchTextBox"
                                 Margin="0,0,5,0"
                                 ToolTip="조직명·창시자·지도자 검색"
                                 TextChanged="SearchTextBox_TextChanged" />
                        <ComboBox x:Name="KindFilterBox"
                                  Grid.Column="1"
                                  Margin="5,0"
                                  SelectedIndex="0"
                                  SelectionChanged="FilterBox_SelectionChanged">
                            <ComboBoxItem Content="전체 종류" />
                            <ComboBoxItem Content="종문" />
                            <ComboBoxItem Content="가문" />
                            <ComboBoxItem Content="왕조" />
                        </ComboBox>
                        <ComboBox x:Name="StatusFilterBox"
                                  Grid.Column="2"
                                  Margin="5,0,0,0"
                                  SelectedIndex="0"
                                  SelectionChanged="FilterBox_SelectionChanged">
                            <ComboBoxItem Content="전체 상태" />
                            <ComboBoxItem Content="활성" />
                            <ComboBoxItem Content="공석" />
                            <ComboBoxItem Content="쇠퇴" />
                            <ComboBoxItem Content="종료" />
                        </ComboBox>
                    </Grid>
                    <DataGrid x:Name="OrganizationGrid"
                              Grid.Row="3"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              SelectionChanged="OrganizationGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="종류" Binding="{Binding Kind}" Width="58" />
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="64" />
                            <DataGridTextColumn Header="인원" Binding="{Binding Members}" Width="58" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="ListStatusText"
                               Grid.Row="4"
                               Margin="2,8,2,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="10" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="OrganizationTitleText"
                                       Text="조직을 선택해 주세요."
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       FontSize="22"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="OrganizationSubtitleText"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="12,6"
                                CornerRadius="10"
                                Background="{StaticResource PanelAltBrush}">
                            <TextBlock x:Name="OrganizationStatusBadgeText"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <TabControl x:Name="OrganizationDetailTabControl"
                                Grid.Row="2"
                                Background="Transparent"
                                BorderThickness="0"
                                SelectionChanged="OrganizationDetailTabControl_SelectionChanged">
                        <TabItem Header="개요">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <local:ResponsiveCardPanel MinimumCardWidth="150"
                                                           MaximumColumns="4"
                                                           ColumnGap="0"
                                                           RowGap="8">
                                    <Border Margin="4" Padding="12" CornerRadius="7" Background="{StaticResource PanelAltBrush}">
                                        <StackPanel>
                                            <TextBlock Text="창시자" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                            <Button x:Name="FounderButton" Margin="0,5,0,0" HorizontalContentAlignment="Left" Click="AgentButton_Click" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="4" Padding="12" CornerRadius="7" Background="{StaticResource PanelAltBrush}">
                                        <StackPanel>
                                            <TextBlock Text="지도자" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                            <Button x:Name="LeaderButton" Margin="0,5,0,0" HorizontalContentAlignment="Left" Click="AgentButton_Click" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="4" Padding="12" CornerRadius="7" Background="{StaticResource PanelAltBrush}">
                                        <StackPanel>
                                            <TextBlock Text="활성 구성원" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                            <TextBlock x:Name="OverviewMembersText" Margin="0,5,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="4" Padding="12" CornerRadius="7" Background="{StaticResource PanelAltBrush}">
                                        <StackPanel>
                                            <TextBlock Text="창설 시각" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                            <TextBlock x:Name="FoundedDateText" Margin="0,5,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </local:ResponsiveCardPanel>
                                <local:ResponsiveCardPanel Grid.Row="2"
                                                           MinimumCardWidth="170"
                                                           MaximumColumns="3"
                                                           ColumnGap="0"
                                                           RowGap="8">
                                    <Border Margin="4" Padding="12" CornerRadius="7" Background="{StaticResource PanelAltBrush}">
                                        <StackPanel>
                                            <TextBlock Text="보유 영석" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                            <TextBlock x:Name="TreasuryText" Margin="0,5,0,0" Foreground="{StaticResource AccentBrush}" FontSize="17" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="4" Padding="12" CornerRadius="7" Background="{StaticResource PanelAltBrush}">
                                        <StackPanel>
                                            <TextBlock Text="평판" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                            <TextBlock x:Name="ReputationText" Margin="0,5,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="17" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="4" Padding="12" CornerRadius="7" Background="{StaticResource PanelAltBrush}">
                                        <StackPanel>
                                            <TextBlock Text="권리·외교" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9" />
                                            <TextBlock x:Name="OverviewAuthorityText" Margin="0,5,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>
                                </local:ResponsiveCardPanel>
                                <Border Grid.Row="3" Margin="4,12,4,4" Padding="14" CornerRadius="7" Background="{StaticResource PanelAltBrush}" VerticalAlignment="Top">
                                    <TextBlock x:Name="OverviewDescriptionText" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="구성원 · 지도부">
                            <DataGrid x:Name="MemberGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="역할" Binding="{Binding Role}" Width="120" />
                                    <DataGridTextColumn Header="충성" Binding="{Binding Loyalty}" Width="90" />
                                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="72" />
                                    <DataGridTemplateColumn Header="관찰" Width="72">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="인물" Tag="{Binding AgentId}" Click="AgentButton_Click" Padding="5,2" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="자산 · 영지">
                            <DataGrid x:Name="RightGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="권리" Binding="{Binding Kind}" Width="180" />
                                    <DataGridTextColumn Header="Atlas 안정 ID" Binding="{Binding Location}" Width="*" />
                                    <DataGridTextColumn Header="취득 시각" Binding="{Binding GrantedAt}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="외교">
                            <DataGrid x:Name="DiplomacyGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="상대 조직" Binding="{Binding Organization}" Width="*" />
                                    <DataGridTextColumn Header="관계" Binding="{Binding Kind}" Width="140" />
                                    <DataGridTextColumn Header="변경 시각" Binding="{Binding ChangedAt}" Width="160" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="전략 · 공개 상태">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Padding="16" CornerRadius="7" Background="{StaticResource PanelAltBrush}">
                                    <StackPanel>
                                        <TextBlock Text="종합 세력 순위" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                                        <TextBlock x:Name="CompositeRankingStateText" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="미승인 사회 자질과 복합 세력 공식은 추정값을 만들지 않습니다." Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Padding="16" CornerRadius="7" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Background="{StaticResource PanelAltBrush}">
                                    <TextBlock x:Name="TemporaryReviewText" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                        </TabItem>
                        <TabItem Header="역사">
                            <DataGrid x:Name="HistoryGrid" Margin="8" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" EnableRowVirtualization="True" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="70" />
                                    <DataGridTextColumn Header="시각" Binding="{Binding Date}" Width="150" />
                                    <DataGridTextColumn Header="사건" Binding="{Binding Kind}" Width="180" />
                                    <DataGridTextColumn Header="세부" Binding="{Binding Detail}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
