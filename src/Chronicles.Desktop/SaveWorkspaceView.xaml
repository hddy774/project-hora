<UserControl x:Class="Chronicles.Desktop.SaveWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Chronicles.Desktop"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource PanelStyle}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="저장 · 9개 세계 슬롯"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="각 카드는 독립된 SQLite 세계와 복구 후보를 사용합니다. 목록 관찰은 권위 payload를 해제하지 않습니다."
                               Margin="0,5,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,6,0"
                            Click="RefreshButton_Click"
                            AutomationProperties.Name="저장 슬롯 목록 새로고침">새로고침</Button>
                    <Button Click="OpenRootButton_Click"
                            AutomationProperties.Name="저장 루트 폴더 열기">저장 폴더</Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="SaveWorkspaceTabControl"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    AutomationProperties.Name="저장 작업 영역">
            <TabItem x:Name="SlotSelectionTab" Header="슬롯 선택">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              AutomationProperties.Name="9개 저장 슬롯 목록">
                    <ItemsControl x:Name="SlotItemsControl" Margin="-4,0,2,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:ResponsiveCardPanel MinimumCardWidth="330"
                                                           MaximumColumns="3"
                                                           ColumnGap="0"
                                                           RowGap="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PanelStyle}"
                                    Margin="4"
                                    Padding="12,9"
                                    MinHeight="146"
                                    BorderBrush="{Binding BorderBrush}"
                                    AutomationProperties.Name="{Binding AccessibilityName}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   Text="{Binding Status}"
                                                   Foreground="{Binding StatusBrush}"
                                                   FontSize="10" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Margin="0,4,0,0"
                                               Text="{Binding SavedAt}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="2" Margin="0,6,0,5">
                                        <TextBlock Text="{Binding WorldLine}"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LeaderLine}"
                                                   Margin="0,2,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FileLine}"
                                                   Margin="0,2,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   FontSize="9"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                MinWidth="0"
                                                Margin="0,0,2,0"
                                                Tag="{Binding SlotId}"
                                                ToolTip="선택한 슬롯의 상세 정보를 봅니다."
                                                AutomationProperties.Name="{Binding SelectAccessibilityName}"
                                                Click="SelectButton_Click">상세</Button>
                                        <Button Grid.Column="1"
                                                MinWidth="0"
                                                Margin="2,0"
                                                Tag="{Binding SlotId}"
                                                ToolTip="현재 세계를 이 슬롯에 저장합니다."
                                                AutomationProperties.Name="{Binding SaveAccessibilityName}"
                                                Click="SaveButton_Click"
                                                Content="{Binding SaveLabel}" />
                                        <Button Grid.Column="2"
                                                MinWidth="0"
                                                Margin="2,0"
                                                Tag="{Binding SlotId}"
                                                IsEnabled="{Binding CanLoad}"
                                                ToolTip="이 슬롯의 세계를 불러옵니다."
                                                AutomationProperties.Name="{Binding LoadAccessibilityName}"
                                                Click="LoadButton_Click">불러오기</Button>
                                        <Button Grid.Column="3"
                                                MinWidth="0"
                                                Margin="2,0,0,0"
                                                Tag="{Binding SlotId}"
                                                IsEnabled="{Binding HasFiles}"
                                                ToolTip="이 슬롯의 저장 폴더를 엽니다."
                                                AutomationProperties.Name="{Binding FolderAccessibilityName}"
                                                Click="FolderButton_Click">폴더</Button>
                                    </Grid>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SlotDetailsTab" Header="선택 상세">
                <Border Style="{StaticResource PanelStyle}" Padding="16,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SelectedSlotTitleText"
                                   Text="슬롯을 선택해 주세요."
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TabControl Grid.Row="1"
                                    Margin="0,9,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    AutomationProperties.Name="선택 슬롯 상세 분류">
                            <TabItem Header="세계">
                                <TextBlock x:Name="SelectedWorldText"
                                           Margin="12,10"
                                           TextWrapping="Wrap" />
                            </TabItem>
                            <TabItem Header="기록">
                                <TextBlock x:Name="SelectedRecordText"
                                           Margin="12,10"
                                           TextWrapping="Wrap" />
                            </TabItem>
                            <TabItem Header="파일">
                                <TextBlock x:Name="SelectedFileText"
                                           Margin="12,10"
                                           TextWrapping="Wrap" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Style="{StaticResource PanelStyle}" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="저장 목록 대기"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="10"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
                <Grid x:Name="OperationProgressPanel"
                      Grid.Row="1"
                      Margin="0,6,0,0"
                      Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="OperationProgressBar"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="저장 작업 진행률" />
                    <TextBlock x:Name="OperationProgressText"
                               Grid.Column="1"
                               Margin="10,0,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="10" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
