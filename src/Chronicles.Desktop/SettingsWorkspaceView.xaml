<UserControl x:Class="Chronicles.Desktop.SettingsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelStyle}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="설정 · 관찰 실험실"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="화면, 다음 세계, 성능 계측과 개발자 밸런스를 서로 분리해 관리합니다."
                               Margin="0,5,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="12,7"
                        CornerRadius="14"
                        Background="{StaticResource AccentDarkBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SettingsStateText"
                               Text="일반 모드"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>

            <TabControl Grid.Row="2" SelectedIndex="0">
                <TabItem Header="화면">
                    <StackPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="인터페이스 배율"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="글자, 카드, 표와 조작 요소를 함께 확대합니다. 변경은 즉시 적용됩니다."
                                               Margin="0,5,0,12"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <UniformGrid Rows="1" Columns="5">
                                        <RadioButton GroupName="UiScale" Style="{StaticResource SegmentToggleStyle}" Margin="0,0,4,0" Tag="0.9" Click="UiScaleButton_Click">90%</RadioButton>
                                        <RadioButton GroupName="UiScale" Style="{StaticResource SegmentToggleStyle}" Margin="4,0" Tag="1.0" IsChecked="True" Click="UiScaleButton_Click">100%</RadioButton>
                                        <RadioButton GroupName="UiScale" Style="{StaticResource SegmentToggleStyle}" Margin="4,0" Tag="1.1" Click="UiScaleButton_Click">110%</RadioButton>
                                        <RadioButton GroupName="UiScale" Style="{StaticResource SegmentToggleStyle}" Margin="4,0" Tag="1.25" Click="UiScaleButton_Click">125%</RadioButton>
                                        <RadioButton GroupName="UiScale" Style="{StaticResource SegmentToggleStyle}" Margin="4,0,0,0" Tag="1.4" Click="UiScaleButton_Click">140%</RadioButton>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="창 크기"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="넓은 관찰을 위해 기본 창은 1,720×1,000으로 시작합니다."
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Margin="0,0,8,0" Click="RestoreWindowButton_Click">기본 크기</Button>
                                        <Button Click="MaximizeWindowButton_Click">화면 채우기</Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="세계 생성">
                    <StackPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="AI 수"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="100~50,000명 · 다음 새 세계부터 적용"
                                                   Margin="0,4,0,9"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBox x:Name="PopulationInput" Text="10000" />
                                        <UniformGrid Rows="1" Columns="4" Margin="0,9,0,0">
                                            <Button Tag="1000" Margin="0,0,3,0" Click="PopulationPresetButton_Click">1천</Button>
                                            <Button Tag="5000" Margin="3,0" Click="PopulationPresetButton_Click">5천</Button>
                                            <Button Tag="10000" Margin="3,0" Click="PopulationPresetButton_Click">1만</Button>
                                            <Button Tag="20000" Margin="3,0,0,0" Click="PopulationPresetButton_Click">2만</Button>
                                        </UniformGrid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="세계 Seed"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="같은 설정과 seed는 같은 세계를 재현합니다."
                                                   Margin="0,4,0,9"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBox x:Name="SeedInput" Text="20260830" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Margin="0,14,0,0"
                                    Padding="16"
                                    CornerRadius="8"
                                    BorderBrush="{StaticResource DangerBrush}"
                                    BorderThickness="1"
                                    Background="#251821">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="새 세계 시작"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="현재 세계는 자동 저장되지 않습니다. 필요한 경우 먼저 저장하세요."
                                                   Margin="0,4,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="WorldCreationStatusText"
                                                   Margin="0,6,0,0"
                                                   Foreground="{StaticResource AccentBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Margin="18,0,0,0"
                                            VerticalAlignment="Center"
                                            Click="CreateWorldButton_Click">설정으로 새 세계 생성</Button>
                                </Grid>
                            </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="성능">
                    <StackPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="실시간 성능 측정기"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="이 화면을 보는 동안에만 시뮬레이션 pulse와 관찰 query 시간을 계측합니다."
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <CheckBox x:Name="PerformanceMeterCheckBox"
                                              Grid.Column="1"
                                              Content="계측 사용"
                                              IsChecked="True"
                                              VerticalAlignment="Center"
                                              Checked="PerformanceMeterCheckBox_Changed"
                                              Unchecked="PerformanceMeterCheckBox_Changed" />
                                </Grid>
                            </Border>

                            <UniformGrid Rows="1" Columns="4" Margin="0,14,0,0">
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="시뮬레이션 pulse" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="SimulationTimingText" Text="대기 중" Margin="0,7,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SimulationAverageText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelStyle}" Margin="5,0">
                                    <StackPanel>
                                        <TextBlock Text="관찰 query" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="ObservationTimingText" Text="대기 중" Margin="0,7,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="ObservationAverageText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelStyle}" Margin="5,0">
                                    <StackPanel>
                                        <TextBlock Text="추정 backlog" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="BacklogText" Text="0 ms" Margin="0,7,0,0" Foreground="{StaticResource PositiveBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="PulseBudgetText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelStyle}" Margin="5,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="표본" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="PerformanceSampleText" Text="0회" Margin="0,7,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="닫힌 탭은 query하지 않음" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                    </StackPanel>
                </TabItem>

                <TabItem Header="개발자">
                    <StackPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="개발자 모드"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="조정값은 다음 새 세계의 권위 상태와 저장 파일에 기록됩니다."
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <CheckBox x:Name="DeveloperModeCheckBox"
                                              Grid.Column="1"
                                              Content="개발자 조정 사용"
                                              VerticalAlignment="Center"
                                              Checked="DeveloperModeCheckBox_Changed"
                                              Unchecked="DeveloperModeCheckBox_Changed" />
                                </Grid>
                            </Border>

                            <Grid x:Name="DeveloperBalancePanel" Margin="0,14,0,0" IsEnabled="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="수행 Work 배율" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="CultivationBalanceValueText" Text="100%" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <Slider x:Name="CultivationBalanceSlider" Minimum="25" Maximum="400" Value="100" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="BalanceSlider_ValueChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="전투 도전 성향" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="CombatBalanceValueText" Text="100%" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <Slider x:Name="CombatBalanceSlider" Minimum="25" Maximum="400" Value="100" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="BalanceSlider_ValueChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="경제 행동 성향" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="EconomyBalanceValueText" Text="100%" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <Slider x:Name="EconomyBalanceSlider" Minimum="25" Maximum="400" Value="100" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="BalanceSlider_ValueChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="요수 위험도" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="MonsterBalanceValueText" Text="100%" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <Slider x:Name="MonsterBalanceSlider" Minimum="25" Maximum="400" Value="100" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="BalanceSlider_ValueChanged" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Margin="0,14,0,0"
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="#251821"
                                    BorderBrush="{StaticResource DangerBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="PC_TEMP_REVIEW · 이 배율은 기획 확정값이 아닌 검토용입니다. 일반 모드 100%가 정식 기준이며, 개발자 모드 세계는 화면과 저장 정보에 명시됩니다."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
