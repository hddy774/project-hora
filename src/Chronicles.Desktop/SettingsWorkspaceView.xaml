<UserControl x:Class="Chronicles.Desktop.SettingsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource PanelStyle}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="설정 · 관찰 실험실"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="화면, 다음 세계, 성능 계측과 세계 설정 배율을 서로 분리해 관리합니다."
                               Margin="0,5,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Padding="12,7"
                        CornerRadius="14"
                        Background="{StaticResource AccentDarkBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SettingsStateText"
                               Text="기본 세계"
                               Foreground="{StaticResource AccentBrush}"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>

            <TabControl Grid.Row="2" SelectedIndex="0">
                <TabItem Header="화면">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelStyle}"
                                    Background="{StaticResource PanelAltBrush}"
                                    Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="인터페이스 배율"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="글자, 카드, 표와 조작 요소를 함께 확대합니다. 변경은 즉시 적용됩니다."
                                               Margin="0,5,0,12"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <UniformGrid Rows="1" Columns="5">
                                        <RadioButton x:Name="UiScale90Toggle" GroupName="UiScale" Style="{StaticResource SegmentToggleStyle}" Margin="0,0,4,0" Tag="0.9" Click="UiScaleButton_Click">90%</RadioButton>
                                        <RadioButton x:Name="UiScale100Toggle" GroupName="UiScale" Style="{StaticResource SegmentToggleStyle}" Margin="4,0" Tag="1.0" IsChecked="True" Click="UiScaleButton_Click">100%</RadioButton>
                                        <RadioButton x:Name="UiScale110Toggle" GroupName="UiScale" Style="{StaticResource SegmentToggleStyle}" Margin="4,0" Tag="1.1" Click="UiScaleButton_Click">110%</RadioButton>
                                        <RadioButton x:Name="UiScale125Toggle" GroupName="UiScale" Style="{StaticResource SegmentToggleStyle}" Margin="4,0" Tag="1.25" Click="UiScaleButton_Click">125%</RadioButton>
                                        <RadioButton x:Name="UiScale140Toggle" GroupName="UiScale" Style="{StaticResource SegmentToggleStyle}" Margin="4,0,0,0" Tag="1.4" Click="UiScaleButton_Click">140%</RadioButton>
                                    </UniformGrid>
                                    <TextBlock x:Name="EffectiveUiScaleText"
                                               Margin="0,9,0,0"
                                               Text="현재 적용 100% · 화면에 온전히 표시됩니다."
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="9"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="ObserverUiStateText"
                                               Margin="0,10,0,0"
                                               Text="관찰 UI 상태: 기본값"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="9"
                                               TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Style="{StaticResource PanelStyle}"
                                    Background="{StaticResource PanelAltBrush}"
                                    Margin="7,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="창 크기"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="기본 창 기준은 1,920×1,080이며 시작 시 작업 영역을 채웁니다."
                                                   Margin="0,5,12,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="WindowModeStateText"
                                                   Text="현재 창 모드 · F11로 전체화면"
                                                   Margin="0,5,12,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="9"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Margin="0,0,8,6" Click="RestoreWindowButton_Click">1920×1080</Button>
                                        <Button Margin="0,0,8,6" Click="MaximizeWindowButton_Click">창 화면 채우기</Button>
                                        <Button Margin="0,0,0,6" Click="FullScreenWindowButton_Click">전체화면</Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="세계 생성">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TabControl>
                            <TabItem Header="기본">
                                <Border Margin="0,12,0,0" Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="AI 수" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="100~50,000명 · 다음 새 세계부터 적용" Margin="0,4,0,9" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBox x:Name="PopulationInput" Text="10000" />
                                            <UniformGrid Rows="1" Columns="4" Margin="0,9,0,0">
                                                <Button Tag="1000" Margin="0,0,3,0" Click="PopulationPresetButton_Click">1천</Button>
                                                <Button Tag="5000" Margin="3,0" Click="PopulationPresetButton_Click">5천</Button>
                                                <Button Tag="10000" Margin="3,0" Click="PopulationPresetButton_Click">1만</Button>
                                                <Button Tag="20000" Margin="3,0,0,0" Click="PopulationPresetButton_Click">2만</Button>
                                            </UniformGrid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="세계 Seed" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="같은 설정·seed는 생성 카탈로그와 AI 세계를 동일하게 재현합니다." Margin="0,4,0,9" Foreground="{StaticResource SecondaryTextBrush}" />
                                            <TextBox x:Name="SeedInput" Text="20260830" />
                                            <TextBlock Margin="0,12,0,0" Text="아이템·서적·지도·요수는 게임플레이 RNG와 분리된 전용 seed를 사용합니다." TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </TabItem>
                            <TabItem Header="아이템·서적">
                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="RandomizeItemsCheckBox" IsChecked="True" Content="아이템 이름·효과 무작위" />
                                            <CheckBox Grid.Column="1" x:Name="RandomizeBooksCheckBox" IsChecked="True" Content="서적 이름·효과 무작위" />
                                            <CheckBox Grid.Column="2" x:Name="FixedUniqueItemsCheckBox" IsChecked="True" Content="고정 유니크 4종 포함" />
                                        </Grid>
                                    </Border>
                                    <UniformGrid Grid.Row="2" Rows="2" Columns="3">
                                        <StackPanel Margin="0,0,8,10"><TextBlock Text="무작위 아이템 종류" Foreground="{StaticResource SecondaryTextBrush}" /><TextBox x:Name="ItemDefinitionCountInput" Text="120" Margin="0,5,0,0" /></StackPanel>
                                        <StackPanel Margin="8,0,8,10"><TextBlock Text="초기 아이템 실물" Foreground="{StaticResource SecondaryTextBrush}" /><TextBox x:Name="ItemInstanceCountInput" Text="2400" Margin="0,5,0,0" /></StackPanel>
                                        <StackPanel Margin="8,0,0,10"><TextBlock Text="서적 내용" Foreground="{StaticResource SecondaryTextBrush}" /><TextBox x:Name="BookContentCountInput" Text="60" Margin="0,5,0,0" /></StackPanel>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="서적 판본" Foreground="{StaticResource SecondaryTextBrush}" /><TextBox x:Name="BookEditionCountInput" Text="90" Margin="0,5,0,0" /></StackPanel>
                                        <StackPanel Margin="8,0,8,0"><TextBlock Text="실물 서적" Foreground="{StaticResource SecondaryTextBrush}" /><TextBox x:Name="PhysicalBookCountInput" Text="600" Margin="0,5,0,0" /></StackPanel>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="고정 유니크는 seed와 무관하게 동일하며, 무작위 정의와 별도 ID를 사용합니다." TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" />
                                    </UniformGrid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="지도·생태·지속 생성">
                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <CheckBox x:Name="RandomizeMapCheckBox" IsChecked="True" Content="지도 지형·정착지 무작위" />
                                            <CheckBox Grid.Column="1" x:Name="RandomizeMonstersCheckBox" IsChecked="True" Content="요수 이름·위험·특성 무작위" />
                                            <CheckBox Grid.Column="2" x:Name="OngoingContentCheckBox" IsChecked="True" Content="세계 지속 생성 사용" />
                                        </Grid>
                                    </Border>
                                    <UniformGrid Grid.Row="2" Rows="2" Columns="3">
                                        <StackPanel Margin="0,0,8,10"><TextBlock Text="지형별 요수 종족" Foreground="{StaticResource SecondaryTextBrush}" /><TextBox x:Name="MonsterSpeciesCountInput" Text="3" Margin="0,5,0,0" /></StackPanel>
                                        <StackPanel Margin="8,0,8,10"><TextBlock Text="서식지별 초기 개체" Foreground="{StaticResource SecondaryTextBrush}" /><TextBox x:Name="MonsterPopulationInput" Text="300" Margin="0,5,0,0" /></StackPanel>
                                        <StackPanel Margin="8,0,0,10"><TextBlock Text="새 콘텐츠 생성 주기(년)" Foreground="{StaticResource SecondaryTextBrush}" /><TextBox x:Name="ContentIntervalYearsInput" Text="10" Margin="0,5,0,0" /></StackPanel>
                                        <StackPanel Margin="0,0,8,0"><TextBlock Text="주기별 새 아이템 종류" Foreground="{StaticResource SecondaryTextBrush}" /><TextBox x:Name="ItemsPerIntervalInput" Text="4" Margin="0,5,0,0" /></StackPanel>
                                        <StackPanel Margin="8,0,8,0"><TextBlock Text="주기별 새 서적 내용" Foreground="{StaticResource SecondaryTextBrush}" /><TextBox x:Name="BooksPerIntervalInput" Text="2" Margin="0,5,0,0" /></StackPanel>
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="PC_TEMP_REVIEW · 생성 상한과 성장 주기는 다음 밸런스 검토 대상입니다." TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
                                    </UniformGrid>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <Border Grid.Row="2" Padding="16" CornerRadius="8" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Background="#251821">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="새 세계 시작" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="현재 세계는 자동 저장되지 않습니다. 필요한 경우 먼저 저장하세요." Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="WorldCreationStatusText" Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Click="CreateWorldButton_Click">설정으로 새 세계 생성</Button>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="성능">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="실시간 성능 측정기"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="열린 설정 화면에서 1초마다 상태를 표본화하며 최근 100개만 메모리에 유지합니다."
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Padding="10,6" Margin="0,0,14,0" CornerRadius="12" Background="{StaticResource AccentDarkBrush}">
                                        <TextBlock x:Name="PerformanceHeaderStatusText"
                                                   Text="측정 대기"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <CheckBox x:Name="PerformanceMeterCheckBox"
                                              Content="계측 사용"
                                              IsChecked="True"
                                              Checked="PerformanceMeterCheckBox_Changed"
                                              Unchecked="PerformanceMeterCheckBox_Changed" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TabControl x:Name="PerformanceDetailTabControl"
                                    Grid.Row="2"
                                    SelectionChanged="PerformanceDetailTabControl_SelectionChanged">
                            <TabItem Header="현재 상태">
                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <UniformGrid Rows="1" Columns="4">
                                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,5,0">
                                            <StackPanel>
                                                <TextBlock Text="시뮬레이션 pulse" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock x:Name="SimulationTimingText" Text="대기 중" Margin="0,7,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="SimulationAverageText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PanelStyle}" Margin="5,0">
                                            <StackPanel>
                                                <TextBlock Text="관찰 query" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock x:Name="ObservationTimingText" Text="대기 중" Margin="0,7,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ObservationAverageText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PanelStyle}" Margin="5,0">
                                            <StackPanel>
                                                <TextBlock Text="추정 backlog" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock x:Name="BacklogText" Text="0 ms" Margin="0,7,0,0" Foreground="{StaticResource PositiveBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="PulseBudgetText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PanelStyle}" Margin="5,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="누적 표본" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock x:Name="PerformanceSampleText" Text="0회" Margin="0,7,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Text="닫힌 관찰 화면은 query하지 않음" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <UniformGrid Grid.Row="2" Rows="1" Columns="4">
                                        <Border Style="{StaticResource PanelStyle}" Margin="0,0,5,0" Background="{StaticResource PanelAltBrush}">
                                            <StackPanel>
                                                <TextBlock Text="최근 성능 상태" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock x:Name="PerformanceHealthText" Text="측정 대기" Margin="0,7,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="PerformanceHealthDetailText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PanelStyle}" Margin="5,0" Background="{StaticResource PanelAltBrush}">
                                            <StackPanel>
                                                <TextBlock Text="프로세스 CPU" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock x:Name="ProcessCpuText" Text="0.0%" Margin="0,7,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ProcessThreadText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PanelStyle}" Margin="5,0" Background="{StaticResource PanelAltBrush}">
                                            <StackPanel>
                                                <TextBlock Text="메모리 상태" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock x:Name="WorkingSetText" Text="0.0 MiB" Margin="0,7,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ManagedHeapText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource PanelStyle}" Margin="5,0,0,0" Background="{StaticResource PanelAltBrush}">
                                            <StackPanel>
                                                <TextBlock Text="최근 100개 p95" Foreground="{StaticResource SecondaryTextBrush}" />
                                                <TextBlock x:Name="RecentP95Text" Text="표본 대기" Margin="0,7,0,0" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock x:Name="RecentSampleWindowText" Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="최근 그래프">
                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="● pulse 예산 사용률" Foreground="{StaticResource AccentBrush}" Margin="0,0,18,0" />
                                        <TextBlock Text="● query 16ms 사용률" Foreground="{StaticResource PositiveBrush}" Margin="0,0,18,0" />
                                        <TextBlock Text="● backlog" Foreground="{StaticResource DangerBrush}" />
                                    </StackPanel>
                                    <Border Grid.Row="2"
                                            Style="{StaticResource PanelStyle}"
                                            Padding="12"
                                            Background="{StaticResource PanelAltBrush}">
                                        <Canvas x:Name="PerformanceGraphCanvas"
                                                MinHeight="250"
                                                ClipToBounds="True"
                                                SizeChanged="PerformanceGraphCanvas_SizeChanged">
                                            <Line x:Name="PerformanceBudgetLine"
                                                  Stroke="{StaticResource SecondaryTextBrush}"
                                                  StrokeThickness="1"
                                                  StrokeDashArray="4,4"
                                                  Opacity="0.55" />
                                            <Polyline x:Name="SimulationGraphLine"
                                                      Stroke="{StaticResource AccentBrush}"
                                                      StrokeThickness="2" />
                                            <Polyline x:Name="ObservationGraphLine"
                                                      Stroke="{StaticResource PositiveBrush}"
                                                      StrokeThickness="2" />
                                            <Polyline x:Name="BacklogGraphLine"
                                                      Stroke="{StaticResource DangerBrush}"
                                                      StrokeThickness="2" />
                                        </Canvas>
                                    </Border>
                                    <TextBlock x:Name="PerformanceGraphSummaryText"
                                               Grid.Row="4"
                                               Text="최근 표본이 쌓이면 100% 예산선을 기준으로 그래프를 표시합니다."
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </Grid>
                            </TabItem>

                            <TabItem Header="최근 100개 로그">
                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="PerformanceLogCountText"
                                               Text="최근 0 / 최대 100개"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <DataGrid x:Name="PerformanceLogGrid"
                                              Grid.Row="2"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              SelectionUnit="FullRow">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="60" />
                                            <DataGridTextColumn Header="시각" Binding="{Binding RecordedAtText}" Width="90" />
                                            <DataGridTextColumn Header="상태" Binding="{Binding HealthText}" Width="75" />
                                            <DataGridTextColumn Header="pulse" Binding="{Binding SimulationText}" Width="95" />
                                            <DataGridTextColumn Header="query" Binding="{Binding ObservationText}" Width="95" />
                                            <DataGridTextColumn Header="backlog" Binding="{Binding BacklogText}" Width="95" />
                                            <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="80" />
                                            <DataGridTextColumn Header="작업 집합" Binding="{Binding WorkingSetText}" Width="100" />
                                            <DataGridTextColumn Header="실행 상태" Binding="{Binding RuntimeStateText}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="파일 출력">
                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="성능·상태 로그 파일"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="자동 기록과 수동 출력은 종류별 폴더에서 파일당 5MiB로 회전합니다."
                                                           Margin="0,5,0,0"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                            <CheckBox x:Name="PerformanceAutoOutputCheckBox"
                                                      Grid.Column="1"
                                                      Content="자동 파일 기록"
                                                      VerticalAlignment="Center"
                                                      Checked="PerformanceAutoOutputCheckBox_Changed"
                                                      Unchecked="PerformanceAutoOutputCheckBox_Changed" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="PerformanceFileStatusText"
                                                           Text="최근 표본 0개 · 자동 기록 꺼짐"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="저장 위치 · %LocalAppData%\ChroniclesOfMyriadImmortalPaths\logs"
                                                           Margin="0,5,0,0"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Margin="0,0,8,0" Click="PerformanceExportButton_Click">최근 100개 출력</Button>
                                                <Button Click="PerformanceFolderButton_Click">로그 폴더 열기</Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </TabItem>

                <TabItem Header="세계 설정">
                    <StackPanel Margin="0,16,0,0">
                            <Border Style="{StaticResource PanelStyle}" Background="{StaticResource PanelAltBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="세계 설정 모드"
                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="조정값은 다음 새 세계의 권위 상태와 저장 파일에 기록됩니다."
                                                   Margin="0,5,0,0"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <CheckBox x:Name="WorldSettingsModeCheckBox"
                                              Grid.Column="1"
                                              Content="실험 배율 사용"
                                              VerticalAlignment="Center"
                                              Checked="WorldSettingsModeCheckBox_Changed"
                                              Unchecked="WorldSettingsModeCheckBox_Changed" />
                                </Grid>
                            </Border>

                            <Grid x:Name="WorldBalancePanel" Margin="0,14,0,0" IsEnabled="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="14" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="수행 Work 배율" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="CultivationBalanceValueText" Text="100%" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <Slider x:Name="CultivationBalanceSlider" Minimum="25" Maximum="400" Value="100" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="BalanceSlider_ValueChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="전투 도전 성향" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="CombatBalanceValueText" Text="100%" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <Slider x:Name="CombatBalanceSlider" Minimum="25" Maximum="400" Value="100" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="BalanceSlider_ValueChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="경제 행동 성향" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="EconomyBalanceValueText" Text="100%" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <Slider x:Name="EconomyBalanceSlider" Minimum="25" Maximum="400" Value="100" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="BalanceSlider_ValueChanged" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource PanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="요수 위험도" Foreground="{StaticResource SecondaryTextBrush}" />
                                        <TextBlock x:Name="MonsterBalanceValueText" Text="100%" Margin="0,4,0,0" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="SemiBold" />
                                        <Slider x:Name="MonsterBalanceSlider" Minimum="25" Maximum="400" Value="100" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="BalanceSlider_ValueChanged" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Margin="0,14,0,0"
                                    Padding="14"
                                    CornerRadius="8"
                                    Background="#251821"
                                    BorderBrush="{StaticResource DangerBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="PC_TEMP_REVIEW · 이 배율은 기획 확정값이 아닌 검토용입니다. 기본 세계 100%가 정식 기준이며, 세계 설정 모드를 사용한 세계는 화면과 저장 정보에 명시됩니다."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="권위 진단">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource PanelStyle}"
                                Background="{StaticResource PanelAltBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="공통 Stable Registry"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="18"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="AuthorityContractText"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="AuthorityCountText"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Padding="12,7"
                                        CornerRadius="14"
                                        Background="{StaticResource AccentDarkBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="AuthorityValidationText"
                                               Text="검증 대기"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>

                        <UniformGrid Grid.Row="2" Rows="1" Columns="2">
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,7,0">
                                <StackPanel>
                                    <TextBlock Text="활성 Authority Schema"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="AuthoritySchemaText"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}" Margin="7,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="활성 Mapping"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="AuthorityMappingText"
                                               Margin="0,7,0,0"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Grid.Row="4" Rows="1" Columns="2">
                            <Expander Header="M01~M14 Primary Owner Stable Ref"
                                      Margin="0,0,7,0">
                                <Border Style="{StaticResource PanelStyle}" Margin="0,8,0,0">
                                    <TextBlock x:Name="AuthorityOwnerRefsText"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Expander>
                            <Expander Header="공식 Stable Ref"
                                      Margin="7,0,0,0">
                                <Border Style="{StaticResource PanelStyle}" Margin="0,8,0,0">
                                    <TextBlock x:Name="AuthorityFormulaRefsText"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </Border>
                            </Expander>
                        </UniformGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
