<UserControl x:Class="Chronicles.Desktop.StatisticsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="4,0">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="DescriptionText"
                           Margin="0,4,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="10"
                           TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock x:Name="RevisionText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="9" />
        </Grid>

        <TabControl x:Name="ViewTabControl"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="ViewTabControl_SelectionChanged"
                    AutomationProperties.Name="통계 표시 방식">
            <TabItem Header="요약 카드">
                <ItemsControl x:Name="SummaryItemsControl" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4"
                                    Padding="12,9"
                                    CornerRadius="7"
                                    Background="{StaticResource PanelAltBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="9" />
                                    <TextBlock Text="{Binding DisplayValue}"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="17"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Note}"
                                               Margin="0,3,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="8"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Note}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>

            <TabItem Header="통계표">
                <DataGrid x:Name="TableGrid"
                          Margin="0,10,0,0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          EnableRowVirtualization="True"
                          ScrollViewer.VerticalScrollBarVisibility="Hidden"
                          AutomationProperties.Name="통계 지표 표">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="지표" Binding="{Binding Label}" Width="1.1*" />
                        <DataGridTextColumn Header="현재 값" Binding="{Binding DisplayValue}" Width="0.7*" />
                        <DataGridTextColumn Header="해석" Binding="{Binding Note}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="막대그래프">
                <ItemsControl x:Name="GraphItemsControl" Margin="4,10,4,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="5" />
                                    <RowDefinition Height="8" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="10" />
                                    <TextBlock Text="{Binding DisplayValue}"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <ProgressBar Grid.Row="2"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Ratio}"
                                             Height="8"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="{StaticResource PanelAltBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
